<!-- Daten als JSON im DOM-->
<section class="aufgabe-details">
  <p><%= data.meta.beschreibung %></p>

  <form method="post" class="calc-form grid-2col">

    <% data.meta.felder.forEach(field => { %>
    <div class="form-row">
      <label for="<%= field.name%>">
        <%= field.label %> (<%= field.unit %>)
      </label>

      <input
        id="<%= field.name %>"
        name="<%= field.name %>"
        type="text"
        value="<%= field.value %><%= field.unit %>"
        class="form-input"
      />
    </div>
    <% }) %>
    
    <div class="form-actions">
      <button type="submit" class="btn-primary">Berechnen</button>
    </div>
  </form>

