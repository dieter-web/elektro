cabal-version:       2.2
name:                mylib
version:             0.1.0.0
build-type:          Simple

library
  exposed-modules:     MyApi
  hs-source-dirs:      src
  build-depends:       base >=4.12 && <5

  default-language:    Haskell2010

executable mylib-ipc
  main-is:             Main.hs
  hs-source-dirs:      app, src
  other-modules:       MyApi
  build-depends:       base, bytestring, aeson, network, unix, directory
  default-language:    Haskell2010
